// Startup HQ: one shared workspace for the founders.
//
// Authorship convention used on every content row: `<x>ById` is the founder the
// change belongs to and `<x>Agent` is the AI that made it on their behalf
// ("Claude", "ChatGPT", "Gemini", "Hermes", ...). Agent null means a person typed
// it. AI never overwrites text a person wrote: it files a Suggestion instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  image     String?
  color     String    @default("#4a6fa5")
  isOwner   Boolean   @default(false)
  googleSub String?   @unique
  /// Let this user's own AI key do background work: summarise new transcripts,
  /// keep the brief current, write the Monday summary.
  autoAI    Boolean   @default(false)
  /// IANA time zone, detected from the browser; times are shown in it.
  timezone  String    @default("Europe/Tallinn")
  /// True when the user picked a zone in Settings; otherwise it follows the browser.
  timezonePinned Boolean @default(false)
  joinedAt  DateTime? // null until the founder signs in for the first time
  createdAt DateTime  @default(now())

  sessions    Session[]
  apiTokens   ApiToken[]
  oauthGrants OAuthGrant[]
  aiKeys      AiKey[]

  assignedTasks Task[] @relation("assignee")
}

model Session {
  id        String   @id // sha256 of the cookie value
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Personal bearer tokens for agents that take a static header (Hermes, CLIs, scripts).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String // what it is for, e.g. "Hermes on the MacBook"
  agent      String // label stamped on everything it writes
  tokenHash  String    @unique
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// MCP clients that registered themselves (RFC 7591), e.g. Claude, ChatGPT, Gemini CLI.
model OAuthClient {
  id               String       @id // client_id
  name             String
  redirectUris     String[]
  secretHash       String? // only for confidential clients
  createdAt        DateTime     @default(now())
  codes            OAuthCode[]
  grants           OAuthGrant[]
}

model OAuthCode {
  codeHash      String      @id
  clientId      String
  userId        String
  agent         String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  usedAt        DateTime?
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// One connected AI app per founder. Access tokens are short-lived; refresh rotates.
model OAuthGrant {
  id               String      @id @default(cuid())
  clientId         String
  userId           String
  agent            String
  accessTokenHash  String      @unique
  accessExpiresAt  DateTime
  refreshTokenHash String      @unique
  refreshExpiresAt DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A founder's own provider key, used by the in-app assistant so nobody burns someone else's credits.
model AiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String // anthropic | openai | google
  model     String
  encrypted String
  last4     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

/// Workspace-wide key/value settings (Drive connection, digest key owner, ...).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(cuid())
  number      Int       @unique @default(autoincrement())
  title       String
  description String    @default("")
  status      String    @default("todo") // proposed | todo | doing | blocked | done | dropped
  priority    String    @default("normal") // low | normal | high | urgent
  assigneeId  String?
  dueDate     DateTime?
  tags        String[]
  meetingId   String?
  goalId      String?
  eventId     String?
  completedAt DateTime?

  createdById String?
  createdAgent String?
  // Who last wrote the title/description. AI may not overwrite a person's text.
  textById    String?
  textAgent   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignee User?         @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  meeting  Meeting?      @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  goal     Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  event    Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([status])
  @@index([goalId])
  @@index([assigneeId])
}

/// Something with a date outside the team's own meetings: an event, a deadline,
/// or an opportunity with an apply-by date. Hermes proposes them from WhatsApp.
model Event {
  id           String            @id @default(cuid())
  number       Int               @unique @default(autoincrement())
  title        String
  kind         String            @default("event") // event | deadline | opportunity
  importance   String            @default("optional") // mandatory | recommended | optional
  startsAt     DateTime
  endsAt       DateTime?
  allDay       Boolean           @default(false)
  /// Where the event happens; its wall-clock time is entered in this zone.
  timezone     String            @default("Europe/Tallinn")
  location     String            @default("")
  url          String            @default("")
  /// Every useful link: [{ label, url }]. Join links (Zoom, Teams, Meet) get a Join button.
  links        Json              @default("[]")
  description  String            @default("")
  source       String            @default("") // "WhatsApp · External Events & Opportunities, 8 Oct"
  sourceQuote  String            @default("")
  status       String            @default("confirmed") // proposed | confirmed | dismissed
  createdById  String?
  createdAgent String?
  textById     String?
  textAgent    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  attendance   EventAttendance[]
  notes        EventNote[]
  tasks        Task[]

  @@index([startsAt])
  @@index([status])
}

/// Who will go: going | maybe | no.
model EventAttendance {
  eventId   String
  userId    String
  status    String
  byAgent   String?
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

/// What someone took away from an event.
model EventNote {
  id        String   @id @default(cuid())
  eventId   String
  body      String
  byId      String?
  agent     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// A goal on the roadmap. Progress comes from the tasks linked to it.
model Goal {
  id           String    @id @default(cuid())
  number       Int       @unique @default(autoincrement())
  title        String
  description  String    @default("")
  status       String    @default("active") // active | achieved | dropped
  horizon      String    @default("now") // now | next | later
  targetDate   DateTime?
  ownerId      String?
  achievedAt   DateTime?
  createdById  String?
  createdAgent String?
  textById     String?
  textAgent    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tasks        Task[]

  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  body      String
  byId      String?
  agent     String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Note {
  id           String    @id @default(cuid())
  title        String
  kind         String    @default("note") // note | meeting | weekly | brief
  pinned       Boolean   @default(false)
  createdById  String?
  createdAgent String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  blocks       Block[]
  meeting      Meeting?

  @@index([kind])
}

/// A paragraph-sized piece of a note. Authorship lives here, so a note can mix
/// a person's text with each founder's AI and every piece shows who wrote it.
model Block {
  id        String   @id @default(cuid())
  noteId    String
  position  Float
  content   String
  byId      String?
  agent     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, position])
}

model Meeting {
  id           String     @id @default(cuid())
  title        String
  date         DateTime
  transcript   String     @default("")
  noteId       String     @unique
  processedAt  DateTime?
  processedBy  String? // "Raiko's Claude"
  createdById  String?
  createdAgent String?
  createdAt    DateTime   @default(now())
  note         Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tasks        Task[]
  decisions    Decision[]
  agendaItems  AgendaItem[]
}

model Decision {
  id           String    @id @default(cuid())
  number       Int       @unique @default(autoincrement())
  title        String
  rationale    String    @default("")
  status       String    @default("active") // open (still to decide) | active | reversed | superseded
  decidedAt    DateTime  @default(now())
  meetingId    String?
  createdById  String?
  createdAgent String?
  // Who last wrote the title/rationale. AI may not overwrite a person's wording.
  textById     String?
  textAgent    String?
  createdAt    DateTime  @default(now())
  meeting      Meeting?  @relation(fields: [meetingId], references: [id], onDelete: SetNull)
}

/// Topics for the next meeting. meetingId is set once a meeting covers it.
model AgendaItem {
  id         String   @id @default(cuid())
  text       String
  byId       String?
  agent      String?
  meetingId  String?
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
}

/// An AI change to something a person wrote, waiting for a person to accept it.
model Suggestion {
  id           String    @id @default(cuid())
  entityType   String // block | task
  entityId     String
  // block: { content } or { delete: true }; task: { title?, description? }
  proposed     Json
  reason       String    @default("")
  byId         String?
  agent        String?
  status       String    @default("open") // open | accepted | rejected
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([entityType, entityId])
}

model DriveLink {
  id          String   @id @default(cuid())
  fileId      String
  name        String
  mimeType    String
  url         String
  taskId      String?
  noteId      String?
  meetingId   String?
  byId        String?
  agent       String?
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([noteId])
  @@index([meetingId])
}

/// Every change, by whom, with the state before it, so any change can be undone.
model Activity {
  id         String   @id @default(cuid())
  entityType String // task | note | block | meeting | decision | agenda | suggestion | drive
  entityId   String
  action     String // created | updated | deleted | ...
  summary    String
  before     Json?
  byId       String?
  agent      String?
  revertedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
