# Postgres. Locally any database works; on Vercel the Neon integration sets these.
DATABASE_URL="postgresql://postgres@localhost:5432/startup_hq"
DATABASE_URL_UNPOOLED="postgresql://postgres@localhost:5432/startup_hq"

# 32+ random characters (openssl rand -base64 32). Encrypts stored API keys and the Drive token.
APP_SECRET=""

# The first person allowed in. With the demo seed: raiko@example.com
OWNER_EMAIL="raiko@example.com"

# Optional locally (use /api/auth/dev instead); required in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APP_URL="http://localhost:3000"
CRON_SECRET=""
